# ============================================================================
# 环境变量契约（单一真源）
# ----------------------------------------------------------------------------
# 维护规则：
#   1. 本文件是所有环境变量的**唯一清单**。新增/改名变量必须同步这里，
#      否则「代码读某个变量」与「部署时注入某个变量」就会静默错配——
#      这正是 P0-CONFIG 要根治的病根（默认值曾被写死在两处、手工同步）。
#   2. **只写占位示例，严禁在本文件写入任何真实密钥 / 密码 / 连接串。**
#      本文件会入库；.env 不会（见 .gitignore：`.env` / `.env.*` 全部忽略，
#      仅 `!.env.example` / `!.env.*.example` 例外）。
#   3. 复制为 .env 后填入真实值；.env 切勿提交。
#
# 分组：§1 前端构建期 · §2 后端运行时 · §3 版本可观测 · §4 CI / 部署变量
# ============================================================================


# ============================================================================
# §1 前端构建期变量（Vite，只暴露 VITE_ 前缀给浏览器代码）
# ----------------------------------------------------------------------------
# 注意：这些变量会被**内联进浏览器产物**，属于公开信息，
#       绝不能把任何密钥放在 VITE_ 前缀变量里。
# ============================================================================

# ----------------------------------------------------------------------------
# VITE_API_BASE —— 生产必填（唯一真源）
# ----------------------------------------------------------------------------
# 用途：线上前端把 /api/* 请求重定向到的后端地址（fetch wrapper 的目标前缀）。
# 必填：生产构建**必填**。漏配时 `vite build` 直接失败，报错来自
#       frontend/vite.config.ts 的 clair-require-api-base plugin
#       （buildStart 阶段校验，dev 不校验），不会静默回落到任何默认地址。
#       三种注入方式都认：GitHub Actions variable、shell 环境变量、frontend/.env。
# 缺失后果：生产构建失败（这是**有意为之**）。曾出现过「代码里一个默认值 +
#       deploy.yml 里又一个默认值」两处手工同步，漏改任一处都不报错，
#       只会静默指向错误后端；现已删除代码侧默认值，真源唯一。
#       ⚠️ 只在 `vite dev`（本地开发）可以不配：dev 模式不做重定向，
#          走 vite proxy 转发到本机后端（frontend/vite.config.ts 的 server.proxy）。
# 示例：VITE_API_BASE=https://clair-api.example.com
# 注意：不要带结尾斜杠（代码会归一化，但保持干净更利于排查）。
VITE_API_BASE=https://clair-api.example.com

# ----------------------------------------------------------------------------
# VITE_API_BASE_URL —— 可选（前端 axios 实例的 baseURL）
# ----------------------------------------------------------------------------
# 用途：frontend/src/services/api.ts 中 axios 实例的 API 前缀。
# 必填：否。
# 缺失后果：回落为 '/api'（相对路径），再由 main.tsx 的全局 fetch wrapper
#       重写到 VITE_API_BASE。**多数情况无需设置**。
# ⚠️ 已知历史遗留（待收敛，当前不要依赖它做后端切换）：
#    它与 VITE_API_BASE 是两个不同变量名，但都指向「后端地址」，
#    容易让人误以为改一个就够。切换后端时以 VITE_API_BASE 为准。
# 示例：VITE_API_BASE_URL=/api
VITE_API_BASE_URL=/api

# ----------------------------------------------------------------------------
# VITE_WS_URL —— 可选（WebSocket 地址）
# ----------------------------------------------------------------------------
# 用途：frontend/src/services/websocket.ts 等的 WebSocket 连接地址。
# 必填：否（但线上建议显式设置）。
# 缺失后果：回落到硬编码的本机地址 http://127.0.0.1:3001，
#       线上将**连不上任何 WebSocket**（表现为实时推送静默失效，
#       不会报错，属于隐蔽故障）。
# 示例：VITE_WS_URL=wss://clair-api.example.com/ws
VITE_WS_URL=wss://clair-api.example.com/ws

# ----------------------------------------------------------------------------
# VITE_WS_BACKUP_URL —— 可选（WebSocket 备用地址）
# ----------------------------------------------------------------------------
# 用途：主 WebSocket 不可用时的备用连接地址。
# 必填：否。缺失后果：无备用链路，主链路故障即实时功能不可用。
# 示例：VITE_WS_BACKUP_URL=wss://backup.example.com/ws
# VITE_WS_BACKUP_URL=


# ============================================================================
# §2 后端运行时变量（backend/，Node 进程；不暴露给浏览器）
# ----------------------------------------------------------------------------
# ⚠️ 线上以容器方式运行（backend/Dockerfile，NODE_ENV=production、PORT=3001）。
#    平台面板上配置的变量会覆盖镜像内的 ENV。
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE_URL —— 生产必填
# ----------------------------------------------------------------------------
# 用途：PostgreSQL 连接串（backend 的唯一持久化来源）。
# 必填：生产**必填**。
# 缺失后果：进程不会崩，但会**退回内存库** ⇒ 全站「诚实空态」
#       （coverage / observations 等数据全空）。
#       ⚠️ 这比部署前更糟：线上当前至少还有 Worker 的部分数据。
#       因此**数据迁移必须先于后端切换**，否则等于把线上打成空站。
# 示例：DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# JWT_SECRET —— 生产必填
# 用途：对用户令牌做 HMAC-SHA256 签名的对称密钥。
# 必填：生产**必填**（backend/src/middleware/auth.ts 生产环境缺失会 FATAL 拒绝启动；
#       非生产环境缺失则生成一次性随机密钥并告警）。
# 缺失后果：**每次重启所有已签发令牌立即失效**（用户被集体登出）；
#       且强度不足时生产直接拒绝启动。
# 示例：JWT_SECRET=<至少 32 字节的随机串，可用 openssl rand -hex 32 生成>
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PORT —— 可选
# 用途：HTTP 监听端口。
# 必填：否。缺失后果：使用默认 3001（与 backend/Dockerfile 的 ENV 一致）。
# ⚠️ 托管平台通常会自行注入 PORT，改动前先确认平台的健康检查路径依赖此端口。
# 示例：PORT=3001
# PORT=3001

# NODE_ENV —— 可选
# 用途：运行模式标识（production / development）。
# 必填：否。缺失后果：按非生产处理，日志与校验行为都可能放宽。
# ⚠️ 镜像内已设 NODE_ENV=production，通常**不需要**在平台重复配置。
# 示例：NODE_ENV=production
# NODE_ENV=production

# CORS_ORIGIN —— 可选
# 用途：允许的前端来源。
# 必填：否。缺失后果：按后端内置默认策略处理；前后端不同域时需显式放行。
# 示例：CORS_ORIGIN=https://<前端域名>
# CORS_ORIGIN=*

# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME —— 可选
# 用途：分项指定数据库连接参数（DATABASE_URL 的替代写法）。
# 必填：否。缺失后果：优先使用 DATABASE_URL；两者都无则退回内存库。
# 示例：DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=a_stock

# DB_POOL_MIN / DB_POOL_MAX —— 可选
# 用途：连接池上下限。
# 必填：否。缺失后果：使用代码内置默认值。
# ⚠️ 托管 PG 的连接数有限制，配过大可能耗尽配额导致数据库不可用。
# 示例：DB_POOL_MIN=2
# DB_POOL_MAX=10

# REDIS_HOST / REDIS_PORT —— 可选
# 用途：Redis 连接（缓存/会话，按功能启用）。
# 必填：否。缺失后果：相关功能不可用，通常会降级而非崩溃。
# 示例：REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT_EXPIRES_IN —— 可选
# 用途：令牌有效期。
# 必填：否。缺失后果：使用代码内置默认值。
# 示例：JWT_EXPIRES_IN=7d
# JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# AI 网关变量（后端调用大模型；按所选 provider 使用）
# ----------------------------------------------------------------------------
# ⚠️ 全部为占位示例，切勿写入真实 key。真实值请放平台 Secrets 或 .env。
# ----------------------------------------------------------------------------
# AI_PROVIDER —— 可选
# 用途：选择大模型供应商（openai / deepseek / local 等）。
# 必填：否。缺失后果：使用代码内置默认 provider。
# 示例：AI_PROVIDER=deepseek
# AI_PROVIDER=deepseek

# DEEPSEEK_API_KEY —— 使用 DeepSeek 时必填
# 缺失后果：AI 功能不可用（前端表现为 AI 面板报错/降级）。
# 示例：DEEPSEEK_API_KEY=sk-REPLACE_ME
# DEEPSEEK_API_KEY=

# DEEPSEEK_BASE_URL —— 可选
# 用途：DeepSeek API 根地址（走网关/代理时改这里）。
# 示例：DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_BASE_URL=

# DEEPSEEK_MODEL —— 可选
# 用途：模型名。
# 示例：DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# OPENAI_API_KEY / CLAUDE_API_KEY / CLAUDE_MODEL / LOCAL_LLM_URL / LOCAL_LLM_MODEL
# 均为对应 provider 的可选变量；缺失时该 provider 不可用。
# 示例：OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_API_KEY=
# CLAUDE_API_KEY=REPLACE_ME
# CLAUDE_MODEL=claude-sonnet-5
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5


# ============================================================================
# §3 版本可观测变量（强烈建议注入：让「线上跑的是哪份代码」可核验）
# ----------------------------------------------------------------------------
# 为什么重要：前端页面上的版本指示器与部署后烟测（scripts/smoke/
# production-smoke.mjs）都靠 commit 比对来确认版本一致。
# 未注入时后端会自报 commit: null（**绝不伪造**），前端只能显示「未知」，
# 于是「本地与线上是否同一版本」这个问题在页面上无法回答。
# ============================================================================

# ----------------------------------------------------------------------------
# GIT_COMMIT_SHA —— 建议注入（后端 & 镜像 build-arg）
# ----------------------------------------------------------------------------
# 用途：后端构建信息。backend/src/app.ts 按 GIT_COMMIT_SHA → BUILD_COMMIT →
#       SOURCE_COMMIT → CF_PAGES_COMMIT_SHA → VERCEL_GIT_COMMIT_SHA 顺序解析，
#       只接受 7–40 位十六进制。
# 必填：否（但生产强烈建议）。
# 缺失后果：GET /api/version 返回 commit: null、commitKnown: false；
#       烟测的 `--expect-commit` 比对无从做起。
# 注入方式：deploy-backend.yml 已通过 build-args 传入
#       GIT_COMMIT_SHA=<commit>，并打进镜像的
#       org.opencontainers.image.revision 标签。
# ⚠️ 该值必须与前端 VITE_GIT_COMMIT_SHA 同源，否则「版本一致性」校验必然失败。
# 格式：40 位小写 hex（取 `git rev-parse HEAD` 的输出）。此处留空，由 CI 注入。
# 注：示例值刻意不写成 40 位连续 hex —— dependencyVulnScan 的「硬编码密钥」门禁
# 会对 `=` 后连续 20+ 位字母数字报错（那正是真实密钥的形状）。
GIT_COMMIT_SHA=

# ----------------------------------------------------------------------------
# BUILD_TIME —— 建议注入
# ----------------------------------------------------------------------------
# 用途：构建时间（ISO 字符串），同样由 /api/version 自报。
#       后端亦接受别名 BUILD_TIMESTAMP。
# 必填：否。缺失后果：/api/version 的 buildTime 为 null。
# 示例：BUILD_TIME=2026-10-06T04:23:00Z
BUILD_TIME=2026-10-06T04:23:00Z

# ----------------------------------------------------------------------------
# VITE_GIT_COMMIT_SHA —— 建议注入（前端构建期）
# ----------------------------------------------------------------------------
# 用途：前端页面版本指示器（frontend/src/config/buildInfo.ts、
#       frontend/src/components/Layout/AppLayout.tsx）。
# 必填：否（但生产强烈建议）。
# 缺失后果：前端展示「未知」；且 buildInfo.ts 的运行期回退依赖
#       浏览器能访问到 /api/version —— 线上后端还没切过去时这条路走不通，
#       于是**只能靠构建期注入**，这也是本变量必须显式注入的原因。
# ⚠️ 注意：.github/workflows/deploy.yml 当前**没有**注入本变量，
#       这是已知缺口（见 docs/deploy/EXPRESS-DEPLOY-PLAN.md 切换清单）。
# 格式同上：40 位小写 hex，由构建时注入（本仓库的 deploy.yml 目前尚未注入，见 §九切换清单）。
VITE_GIT_COMMIT_SHA=

# ----------------------------------------------------------------------------
# VITE_BUILD_TIME / VITE_BUILD_COMMIT / VITE_APP_VERSION —— 可选（前端构建期）
# ----------------------------------------------------------------------------
# 用途：前端构建信息展示。
# 必填：否。缺失后果：对应字段显示「未知」。
# 示例：VITE_BUILD_TIME=2026-10-06T04:23:00Z
# 示例：VITE_APP_VERSION=1.7.0
# VITE_BUILD_TIME=
# VITE_BUILD_COMMIT=
# VITE_APP_VERSION=


# ============================================================================
# §4 CI / 部署平台变量（不是进程环境变量，而是 GitHub 仓库级 variable）
# ----------------------------------------------------------------------------
# 在仓库 Settings → Secrets and variables → Actions → Variables 中配置。
# ⚠️ 这些不是 .env 里的东西，写进 .env 不生效——分清两类来源是排查配置问题
#    的第一步（曾出现过「.env 里配了但构建读不到」的困惑）。
# ============================================================================

# ----------------------------------------------------------------------------
# BACKEND_SMOKE_BASE_URL —— 建议配置（仓库级 Actions variable）
# ----------------------------------------------------------------------------
# 用途：部署后自动烟测的目标基地址。由 deploy-backend.yml 的 smoke job 读取
#       （workflow_dispatch 的 smoke_base 输入优先于它）。
# 必填：否——但**强烈建议配置**，否则该 job 呈skipped（灰色），
#       「部署后端」这件事没有任何机器校验。
# 缺失后果：smoke job 被跳过，不会跑 production-smoke.mjs。
#       （该 job 在未配置时明确显示 skipped，不会伪装成绿色通过。）
# 示例：BACKEND_SMOKE_BASE_URL=https://clair-api.example.com
BACKEND_SMOKE_BASE_URL=https://clair-api.example.com

# ----------------------------------------------------------------------------
# VITE_API_BASE（GitHub Actions variable）—— 生产必填
# ----------------------------------------------------------------------------
# 用途：deploy.yml 在构建前端时注入的 VITE_API_BASE。
# 必填：生产必填。
# 缺失后果：⚠️ 注意 deploy.yml 当前写作
#       `vars.VITE_API_BASE || 'https://clair-api.pages.dev'`，
#       也就是说**GitHub variable 缺失时不会报错，而是回落到 Worker 地址**，
#       前端于是又静默指向旧后端。
#       ⚠️ 这是当前残留的**最后一个双源默认值**：代码侧默认值已删除，
#          但工作流侧的兜底还在。彻底修法见
#          docs/deploy/EXPRESS-DEPLOY-PLAN.md 的切换清单第 5 步。
# 示例：VITE_API_BASE=https://clair-api.example.com
# （在 GitHub Actions Variables 中配置同名 variable 即可）