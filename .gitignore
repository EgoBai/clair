# 依赖与构建产物
node_modules/
dist/
build/
.vite/
coverage/

# 环境变量 —— 任何层级的 .env 一律不入库，只提交 .env.example
.env
.env.*
!.env.example
!.env.*.example

# 日志与临时文件
*.log
.cache/
tmp/

# 编辑器副本 / 回收站
*.bak
*.bak-*
*.orig
*.tmp
.trash-bak/
.DS_Store

# git filter-repo / 重写历史临时目录（非源码，禁止入库）
.git-rewrite/
.git-push-bundles/
