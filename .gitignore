# 依赖与构建产物
node_modules/
dist/
build/
.vite/
coverage/

# shared/ 的 .ts 编译残留（事故 T-2604：types.js 影子化 .ts 根因，源码只有 .ts，.js/.d.ts 一律不入库）
shared/*.js
shared/*.d.ts

# 环境变量 —— 任何层级的 .env 一律不入库，只提交 .env.example
.env
.env.*
!.env.example
!.env.*.example

# 日志与临时文件
*.log
.cache/
tmp/

# 编辑器副本 / 回收站
*.bak
*.bak-*
*.orig
*.tmp
.trash-bak/
.DS_Store

# 密钥 / 证书 / 凭据 —— 任何密钥类文件一律不入库
# (nginx/ssl 自签名开发证书、SSH key、npm token 等)
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
*.npmrc
credentials.json
*.secret

# 测试产物（Playwright 报告 / 截图 / 视频，体积大且非源码）
playwright-report/
test-results/


# git filter-repo / 重写历史临时目录（非源码，禁止入库）
.git-rewrite/
.git-push-bundles/

# ===== Agent 验证残留（2026-10-07 补）=====
# 多worker 并发时留下的临时 harness / 验证脚本，单个可达 11MB（编译产物）。
# 它们不在任何 worker 的授权文件域内，但 `git add -A` 会把它们卷进commit。
# 教训：验证产物必须留在 /tmp，或至少禁止入库。
frontend/.tempgauge-harness.*
frontend/nulladapt-verify.tsx
frontend/*-verify-tmp.*
frontend/vite.*verify*.ts
frontend/vite.config.*-temp.*
frontend/vite.config.*-temp.js
frontend/nv.tmp.*
frontend/serve-verify.mjs
frontend/checkApiBase*.mjs
*.harness.cjs
*.harness.tsx

# ⚠️ 高危补充（2026-10-07 02:47）
# `vite.config.bt-temp.ts` 这类临时 vite 配置若被提交并覆盖真实 vite.config.ts，
# 会把 server.proxy 的 /api 目标从 3001 静默改到 3411 —— **前端不报错、只是拿不到数据**。
# 「静默失效」比误提交测试文件危险得多：CI 不红、dev 不报错，只有用户看到空页面。
# 因此禁止任何 `vite.config.*-temp*` / `*-verify*` 形态的配置文件入库。
vite.config.*-temp.*
frontend/vite.config.bt-temp.ts

# ⚠️ 数据脚本的 checkpoint / report 产物（2026-10-25 补）
# `backfill-kline-history.cjs` 默认把断点续跑状态写到**仓库内**：
#   scripts/data/.backfill-kline-history.checkpoint.json
#   scripts/data/.backfill-kline-history.report.json
# 这两个是**一次性运行产物**（跑一次就产生），不是数据快照、不是基线、不是可复现输入。
# 但它们落在仓库内且未被忽略，于是：任何人跑一次脚本 → 产生未跟踪文件 → 污染 `git status`
# → `git add -A` 一把卷进提交 → 后来者误以为「这是某次数据快照」，甚至照着它当基准做比对。
# 危害等级与上面的 vite.config.* 同级：CI 不红、脚本不报错，只有工作树被悄悄弄脏。
# 同一目录下其他脚本（stale-px-*.mjs / probe-*.ts / backfill-missing-kline.ts 等）
# 的产物默认都落在 /tmp/，只有本脚本默认落在仓库内 —— 故只针对本脚本的模式收口，不扩大化。
scripts/data/.backfill-kline-history.*
