# ============================================================
# 资金流后端代理 · 上游数据源 API Key 配置 (Ticket D4-a)
# 复制本文件为 .env 并按需填写；未配置时自动降级到确定性演示兜底(DemoProvider)。
# ============================================================

# —— Tushare Pro（A股资金流主源）——
# 注册获取：https://tushare.pro  申请 token 后填入下方。
# 配置后 TushareProvider 自动激活（isAvailable=true）。
TUSHARE_TOKEN=

# —— AkShare（兜底，需自建 HTTP 代理）——
# AkShare 为 Python 库，后端不直连；需自行部署一个 HTTP 代理服务，
# 暴露如 GET {AKSHARE_PROXY_URL}/stock_individual_fund_flow 的接口。
# 配置后 AkShareProvider 自动激活。
AKSHARE_PROXY_URL=

# —— Alpha Vantage（国际/外资资金视角主源）——
# 注册获取：https://www.alphavantage.co/support/#api-key
# 配置后 AlphaVantageProvider 自动激活；/fund-flow/global 走真实调用。
ALPHAVANTAGE_KEY=

# ============================================================
# 安全配置（F06：密钥必须来自环境变量，代码内无兜底默认值）
# ============================================================

# —— JWT 签名密钥（必填，生产环境缺失或长度 < 32 时进程启动即失败）——
# 生成方式：openssl rand -hex 32
# 请勿提交真实值到版本库；轮换密钥会使所有已签发令牌立即失效。
JWT_SECRET=

# —— DeepSeek AI（AI 对话/分析）——
# 密钥仅允许通过环境变量注入，禁止硬编码或提交到仓库。
DEEPSEEK_API_KEY=
