# ============================================================
# 澄观 Clair · 后端环境变量清单
#
# 本文件是 backend/ 的**唯一**环境变量契约（单一真源）。
# 生成方式（改动代码后请重新核对，不得漏项）：
#   rg -n "process\.env\." backend/src --no-heading
# 逐项列出：变量名 / 用途 / 是否必填 / 默认值。
#
# 复制为 .env 后按需填写。**任何密钥类变量都不得提交入库**
# （.gitignore 已排除 .env / .env.*，仅放行 .env.example）。
#
# ⚠️ 生产环境必读：
#   1. NODE_ENV=production 时，JWT_SECRET 缺失或长度 < 32 会**直接启动失败**
#      （见 backend/src/middleware/auth.ts resolveJwtSecret）。
#   2. DATABASE_URL 连不上时后端**不会崩**，但会静默降级到内存库：
#      /health 会返回 dbType='memory'、degraded=true、dataSource='unavailable'，
#      此时全站无真实行情/估值来源（诚实空态，不伪造数据）。
#      → 部署后请务必 curl /health 确认 dbType 是 'postgresql'。
# ============================================================


# ============================================================
# 1. 服务监听（容器化托管必需）
# ============================================================

# HTTP 监听端口。
# 用途：Express 监听端口（backend/src/index.ts、app.ts）
# 必填：否
# 默认：3001
# 托管平台通常会注入自己的 PORT，以平台实际值为准。
PORT=3001

# 监听地址（网卡）。
# 用途：Express 绑定哪个网卡（backend/src/index.ts）
# 必填：否
# 默认：0.0.0.0（监听所有网卡 —— 容器内必须如此，否则平台探针连不上）
# 本机开发若只想监听回环可设 127.0.0.1。
HOST=0.0.0.0

# 运行环境。
# 用途：多处行为分支（生产拒供伪造数据、CORS 生产白名单、CSRF secure、错误详情脱敏、日志级别）
# 必填：否
# 默认：未设置时各处按 development 处理
# 取值：development | production | test
NODE_ENV=development

# 逻辑版本号（仅用于 /health 与 /api/version 的自报版本）。
# 用途：健康检查/版本端点显示的版本号（backend/src/api/health.ts）
# 必填：否
# 默认：1.7.0
# 注意：进程内另有单一版本真源常量（app.ts 的 APP_VERSION），此处仅覆盖健康端点自报值。
APP_VERSION=1.7.0

# 日志级别。
# 用途：后端日志输出级别（backend/src/services/logger.ts）
# 必填：否
# 默认：info
# 取值：error | warn | info | debug
LOG_LEVEL=info


# ============================================================
# 2. 数据库（PostgreSQL）
# ============================================================

# PostgreSQL 连接串（**首选**配置方式，优先级高于下面的 DB_* 分项）。
# 用途：数据库工厂 initDatabase() 建立 PG 连接的唯一依据（backend/src/db/dbFactory.ts）
# 必填：生产环境强烈建议必填（缺失 → 降级内存库 → 全站无真实行情）
# 默认：无（未设置即走内存库降级）
# 示例：postgresql://user:password@host:5432/dbname
#      unix socket 形态：postgresql://user@/dbname?host=/var/run/postgresql
DATABASE_URL=

# PG 主机名（仅当不用 DATABASE_URL 时生效）。
# 用途：knex 连接配置（backend/src/db/Database.ts defaultConfig）
# 必填：否
# 默认：localhost
DB_HOST=localhost

# PG 端口（仅当不用 DATABASE_URL 时生效）。
# 用途：knex 连接配置
# 必填：否
# 默认：5432
DB_PORT=5432

# PG 用户名（仅当不用 DATABASE_URL 时生效）。
# 用途：knex 连接配置
# 必填：否
# 默认：postgres
DB_USER=postgres

# PG 密码（仅当不用 DATABASE_URL 时生效）。
# 用途：knex 连接配置
# 必填：否
# 默认：password
# ⚠️ 生产环境请用 DATABASE_URL 传密，或用密钥管理注入，勿写死在文件里。
DB_PASSWORD=password

# PG 数据库名（仅当不用 DATABASE_URL 时生效）。
# 用途：knex 连接配置
# 必填：否
# 默认：a_stock
DB_NAME=a_stock

# 连接池最小连接数。
# 用途：knex 连接池下界（backend/src/db/Database.ts）
# 必填：否
# 默认：2
DB_POOL_MIN=2

# 连接池最大连接数。
# 用途：knex 连接池上界
# 必填：否
# 默认：20
# ⚠️ 容器化托管注意：托管平台的连接数上限常低于本机自建 PG，
#    过多连接会耗尽 PG 的 max_connections，建议按平台配额下调。
DB_POOL_MAX=20


# ============================================================
# 3. 安全与访问控制
# ============================================================

# JWT 签名密钥（对称 HS256）。
# 用途：用户令牌签发/校验（backend/src/middleware/auth.ts、utils/tokenManager.ts）
# 必填：**生产环境必填**
# 默认：无（生产环境缺失或长度 < 32 → 进程启动即失败）
# 生成方式：openssl rand -hex 32
# ⚠️ 轮换密钥会使所有已签发令牌立即失效。
JWT_SECRET=

# 生产环境额外允许的 CORS 源（追加到内置白名单之外）。
# 用途：生产 CORS 白名单（backend/src/middleware/corsConfig.ts）
# 必填：否
# 默认：空（仅用内置白名单）
# 格式：逗号分隔的完整 origin，例：https://clair.market,https://my-app.vercel.app
CORS_ORIGINS=


# ============================================================
# 4. AI 服务（多供应商）
# ============================================================

# AI 供应商选择。
# 用途：aiService 选哪家（backend/src/services/aiService.ts）
# 必填：否
# 默认：deepseek
# 取值：deepseek | openai | claude | local
AI_PROVIDER=deepseek

# DeepSeek API Key（AI_PROVIDER=deepseek 时需要）。
# 用途：调用 DeepSeek Chat API
# 必填：使用该供应商时必填
# 默认：空（则 AI 相关功能不可用）
DEEPSEEK_API_KEY=

# DeepSeek API Base URL。
# 用途：DeepSeek 接口地址
# 必填：否
# 默认：https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名。
# 用途：指定 DeepSeek 模型
# 必填：否
# 默认：deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API Key（AI_PROVIDER=openai 时需要）。
# 用途：调用 OpenAI Chat API
# 必填：使用该供应商时必填
# 默认：空
OPENAI_API_KEY=

# OpenAI API Base URL。
# 用途：OpenAI 接口地址（兼容代理网关）
# 必填：否
# 默认：https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型名。
# 用途：指定 OpenAI 模型
# 必填：否
# 默认：gpt-4o
OPENAI_MODEL=gpt-4o

# Anthropic Claude API Key（AI_PROVIDER=claude 时需要）。
# 用途：调用 Claude API
# 必填：使用该供应商时必填
# 默认：空
CLAUDE_API_KEY=

# Claude 模型名。
# 用途：指定 Claude 模型
# 必填：否
# 默认：claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 本地 LLM 服务地址（AI_PROVIDER=local 时需要）。
# 用途：本地 Ollama / 兼容 OpenAI 协议的服务地址
# 必填：使用该供应商时必填
# 默认：http://localhost:11434
LOCAL_LLM_URL=http://localhost:11434

# 本地 LLM 模型名（AI_PROVIDER=local 时需要）。
# 用途：指定本地模型
# 必填：使用该供应商时必填
# 默认：qwen2.5
LOCAL_LLM_MODEL=qwen2.5


# ============================================================
# 5. 资金流数据源（多源自动降级）
# ============================================================

# Tushare Pro token（A 股资金流主源）。
# 用途：调用 Tushare Pro 资金流接口（backend/src/services/fundFlowProviders.ts）
# 必填：否
# 默认：空（未配置则该数据源不可用，资金流降级到其它源）
# 获取：https://tushare.pro 注册后申请
TUSHARE_TOKEN=

# AkShare 自建 HTTP 代理地址。
# 用途：AkShare 是 Python 库，后端不直连；需自建代理暴露 HTTP 接口
# 必填：否
# 默认：空（未配置则该数据源不可用）
# 代理需暴露形如 {AKSHARE_PROXY_URL}/stock_individual_fund_flow 的接口
AKSHARE_PROXY_URL=

# Alpha Vantage API Key（国际/外资资金视角数据源）。
# 用途：调用 Alpha Vantage（/fund-flow/global 走真实调用）
# 必填：否
# 默认：空（未配置则该数据源不可用）
# 获取：https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# 数字预言机（多信号引擎）服务地址。
# 用途：多信号引擎调用的外部 oracle 服务（backend/src/services/multiSignalEngine.ts）
# 必填：否
# 默认：http://localhost:8001
DIGITAL_ORACLE_URL=http://localhost:8001


# ============================================================
# 6. 知识库
# ============================================================

# 知识库文档目录。
# 用途：RAG 检索的文档根目录（backend/src/utils/knowledgeRetrieval.ts）
# 必填：否
# 默认：自动探测（cwd / __dirname 向上查找，找不到则该功能不可用）
# 注：设置后若路径不存在，会回退到自动探测。
KNOWLEDGE_BASE_DIR=


# ============================================================
# 7. 构建信息（部署后版本核对用）
# ============================================================

# git commit sha（部署实例自报，用于与期望 commit 比对）。
# 用途：/health.build.commit 与 /api/version 的 commit 来源
# 必填：否（取不到就是 null，**绝不伪造**）
# 默认：无
# 注：以下 5 个变量按顺序取第一个「形如 7-40 位十六进制」的值。
GIT_COMMIT_SHA=

# 同上，构建系统注入的 commit。
BUILD_COMMIT=

# 同上，源码来源标识。
SOURCE_COMMIT=

# 同上，Cloudflare Pages/Workers 平台自动注入。
CF_PAGES_COMMIT_SHA=

# 同上，Vercel 平台自动注入。
VERCEL_GIT_COMMIT_SHA=

# 构建时间（ISO 字符串或 SOURCE_DATE_EPOCH 风格的秒级时间戳）。
# 用途：/health.build.buildTime
# 必填：否
# 默认：无
# ⚠️ 取不到就是 null，不用进程启动时间冒充构建时间。
BUILD_TIME=

# 构建时间戳（同上，数值秒级）。
# 用途：BUILD_TIME 未设时的备选来源
# 必填：否
# 默认：无
BUILD_TIMESTAMP=


# ============================================================
# 8. 其它
# ============================================================

# Sentry DSN（错误上报）。
# 用途：错误上报到 Sentry（backend/src/utils/errorTracker.ts）
# 必填：否
# 默认：空（不上报）
# 注：当前代码中该变量仅在注释示例里出现，尚未接入实际发送逻辑。
SENTRY_DSN=

# npm 注入的包版本号（无需手工设置）。
# 用途：utils/healthCheck.ts 的 version 字段
# 必填：否（由 npm 运行时自动注入）
# 默认：1.0.0
npm_package_version=


# ============================================================
# 9. 逃生开关（仅应急，禁止在生产长期开启）
# ============================================================

# 是否允许在生产环境的内存库降级态下**不抛错**、改返回诚实空态。
# 用途：控制 FabricatedDataRefusedError 是否生效（backend/src/db/FabricatedDataRefusedError.ts）
# 必填：否
# 默认：未设置 = 关闭拒供（即：生产降级时行情类端点返回 503 + dataSource=unavailable）
# ⚠️ 设为 'true' 只会让行情类读取返回**诚实空态**而非抛错，
#    **不会**放行任何伪造数据（R0'-9 起内存库已无伪造行情生成器）。
#    仅用于「先让页面不报错，数据缺失稍后补」的场景。
ALLOW_FABRICATED_MARKET_DATA=
